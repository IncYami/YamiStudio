Dialogue: 0,0:22:00.69,0:22:04.34,ED Romaji,,0,0,0,,{\fad(150,150)\blur8}dangan no ame ni utare ni yuku no ka
Dialogue: 0,0:22:04.34,0:22:10.26,ED Romaji,,0,0,0,,{\fad(150,150)\blur8}shoushisenban! kuni no tame da!
Dialogue: 0,0:22:10.52,0:22:14.12,ED Romaji,,0,0,0,,{\fad(150,150)\blur8}senjou e! zensen e! soshite shi no fuchi made!
Dialogue: 0,0:22:14.12,0:22:18.43,ED Romaji,,0,0,0,,{\fad(150,150)\blur8}inochi suteta kakugo o shimese yo!
Dialogue: 0,0:22:18.43,0:22:22.09,ED Romaji,,0,955,0,,{\fad(150,150)\blur8}chuusei o! juujun o!\N soshite sono tamashii o
Dialogue: 0,0:22:22.09,0:22:26.57,ED Romaji,,0,955,0,,{\fad(150,150)\blur8}subete sasage kachidoki o age yo!
Dialogue: 0,0:22:26.57,0:22:30.46,ED Romaji,,0,0,0,,{\fad(150,150)\blur8}saa koko ni kizuitemisero!
Dialogue: 0,0:22:30.57,0:22:36.72,ED Romaji,,0,0,0,,{\fad(150,150)\blur8}ten ni todoku hito no yama o!
